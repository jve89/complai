# ─────────────────────────────────────────────────────────────────────────────
# ComplAI — environment variables
# Copy to `.env` and fill in. The app runs in "stub" mode for any integration
# whose keys are absent (Stripe/Resend), so you can develop with only the
# database + Supabase auth configured.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Database (Prisma → Supabase Postgres) ───────────────────────────────────
# When running the local Supabase stack (`supabase start`), the default is:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# For Supabase Cloud, use the "Connection string" (use the pooled 6543 port for
# the app and the direct 5432 port for migrations via DIRECT_URL if needed).
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Local defaults are printed by `supabase start`. For cloud, see Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-from-supabase-start>"
# Server-only key for admin operations (deleting accounts removes the Supabase
# login via this key). Dashboard → Project Settings → API → service_role.
# Full database access — never expose to the client or commit the real value.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# ── Stripe (optional — billing runs in stub mode if unset) ──────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_CORP_MONTHLY=""
STRIPE_PRICE_CORP_YEARLY=""

# ── Resend (optional — emails are logged to console if unset) ───────────────
RESEND_API_KEY=""
EMAIL_FROM="ComplAI <onboarding@resend.dev>"

# ── ComplAI staff ───────────────────────────────────────────────────────────
# Comma-separated emails that may access /dashboard/admin (manage all clients).
SUPER_ADMIN_EMAILS=""
