// ComplAI — EU AI Act compliance platform
// Prisma owns the schema and runs migrations against the Supabase Postgres DB.
// Supabase Auth owns identity; `User.id` mirrors the Supabase auth user id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  manager
  employee
}

enum AiRole {
  provider
  deployer
}

enum RiskLevel {
  minimal
  limited
  high
  unacceptable
}

enum ComplianceStatus {
  compliant
  open
  in_progress
}

model Company {
  id        String   @id @default(cuid())
  name      String
  size      String? // e.g. "1-10", "11-50", "51-250", "250+"
  sector    String?
  country   String   @default("NL")
  logoUrl   String?  @map("logo_url")
  // Optional legal-identity fields — filled once in Settings, interpolated into
  // documents (conformity declaration, technical file). Never mandatory: a blank
  // just leaves a fill-in marker in the concept document.
  kvk          String? // KvK-nummer
  address      String?
  legalRepName String? @map("legal_rep_name") // signatory name
  legalRepRole String? @map("legal_rep_role") // signatory function
  // Compliance profile (Phase 1): recommended tier, derived roles/tiers, and the
  // full ComplianceProfile snapshot the dashboard reads.
  plan        String?  // PURCHASED/active tier: gratis|starter|groei|schaal
  entityRoles String[] @map("entity_roles")
  riskTiers   String[] @map("risk_tiers")
  profileJson Json?    @map("profile_json")
  // Stripe billing (set by the checkout webhook; the portal manages changes).
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  stripeSubscriptionId String?   @map("stripe_subscription_id")
  planStatus           String?   @map("plan_status") // active|trialing|past_due|canceled
  planRenewsAt         DateTime? @map("plan_renews_at")
  // "Aan de slag" checklist: hidden forever once dismissed (or all steps done).
  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at")
  createdAt DateTime @default(now()) @map("created_at")

  users               User[]
  aiSystems           AiSystem[]
  scanResults         ScanResult[]
  documents           Document[]
  employees           Employee[]
  complianceItems     ComplianceItem[]
  trainingCompletions TrainingCompletion[]
  invites             Invite[]
  incidents           Incident[]
  notices             Notice[]

  @@map("companies")
}

/// Processed Stripe webhook events — insert-or-skip gives idempotency, so a
/// redelivered event never repeats emails or writes.
model StripeEvent {
  id        String   @id // Stripe event id (evt_…)
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

/// A pending team invitation. Consumed at signup to join the company + role.
model Invite {
  id        String   @id @default(cuid())
  email     String
  role      String   @default("employee") // admin | manager | employee
  token     String   @unique
  accepted  Boolean  @default(false)
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at") // null = legacy invite, treated as non-expiring

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invites")
}

model User {
  id        String   @id // = Supabase auth uid
  email     String   @unique
  name      String?
  role      Role     @default(admin)
  companyId String?  @map("company_id")
  // ComplAI staff who can manage all clients (distinct from `role`, which is the
  // beheerder/manager/medewerker role WITHIN a client company).
  superAdmin Boolean @default(false) @map("super_admin")
  createdAt DateTime @default(now()) @map("created_at")

  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  scanResults  ScanResult[]
  employee     Employee?

  @@index([companyId])
  @@map("users")
}

/// Audit trail: a super-admin entering (impersonating) a client's dashboard.
model ImpersonationLog {
  id          String   @id @default(cuid())
  adminUserId String   @map("admin_user_id")
  adminEmail  String   @map("admin_email")
  companyId   String   @map("company_id")
  companyName String   @map("company_name")
  startedAt   DateTime @default(now()) @map("started_at")

  @@index([adminUserId])
  @@map("impersonation_logs")
}

model AiSystem {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  description String?
  vendor      String?
  role        AiRole    @default(deployer)
  riskLevel   RiskLevel @default(limited) @map("risk_level")
  status      String    @default("active") // active | review | retired
  // Art 26(2) — the employee assigned to human oversight of this (high-risk) system.
  oversightEmployeeId String? @map("oversight_employee_id")
  // Art 26(6) — the deployer's log-retention policy for this (high-risk) system:
  // where the auto-generated logs are kept, for how many months (≥ 6), who owns
  // it, and when it was last reviewed. Evidence of the policy — we don't hold logs.
  logLocation        String?   @map("log_location")
  logRetentionMonths Int?      @map("log_retention_months")
  logRetentionOwner  String?   @map("log_retention_owner")
  logReviewedAt      DateTime? @map("log_reviewed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  oversight Employee? @relation(fields: [oversightEmployeeId], references: [id], onDelete: SetNull)
  notices   Notice[] // information/explanation notices issued for this system (Art 26(7)/(11), 86)

  @@index([companyId])
  @@map("ai_systems")
}

/// Serious-incident register (Art 73). A company logs a serious incident; the
/// category (Art 3(49) a–d) + death/widespread flags drive the reporting
/// deadline (Art 73(2)–(4)). Status tracks open → reported → closed.
model Incident {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  title         String
  description   String?
  category      String    @default("health") // Art 3(49): health | critical_infra | fundamental_rights | property_env
  involvesDeath Boolean   @default(false) @map("involves_death") // Art 73(4) → 10 dagen
  widespread    Boolean   @default(false) // Art 73(3) wijdverspreide inbreuk → 2 dagen
  awareAt       DateTime  @map("aware_at") // datum bekend geworden — start van de meldtermijn
  occurredAt    DateTime? @map("occurred_at")
  status        String    @default("open") // open | reported | closed
  reportedAt    DateTime? @map("reported_at")
  reference     String? // kenmerk/ontvangstbevestiging van de toezichthouder
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("incidents")
}

/// Register of information & explanation notices a high-risk deployer must issue:
/// Art 26(7) (inform workers + their representatives before workplace use),
/// Art 26(11) (inform natural persons subject to an Annex III decision), and
/// Art 86 (respond to a right-to-explanation request). Each row is BOTH the
/// evidence the duty was met and the source for a pre-filled notice/explanation
/// PDF. These Annex III deployer duties apply from 2 Dec 2027 (Digital Omnibus
/// deferral — re-verify against the published OJ).
model Notice {
  id         String    @id @default(cuid())
  companyId  String    @map("company_id")
  type       String // worker (Art 26(7)) | affected (Art 26(11)) | explanation (Art 86)
  aiSystemId String?   @map("ai_system_id") // the high-risk system the notice concerns
  recipient  String // wie is/wordt geïnformeerd (OR, werknemers, betrokkene, naam)
  method     String? // hoe verstrekt: e-mail | brief | intranet | gesprek
  detail     String? // Art 86: hoofdelementen van het besluit / rol van het AI-systeem; of interne aantekening
  status     String    @default("draft") // draft | issued
  issuedAt   DateTime? @map("issued_at") // datum verstrekt (null zolang concept)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aiSystem AiSystem? @relation(fields: [aiSystemId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("notices")
}

model ScanResult {
  id        String   @id @default(cuid())
  companyId String?  @map("company_id")
  userId    String?  @map("user_id")
  score     Int
  answers   Json
  profile   Json? // computed ComplianceProfile snapshot
  reportUrl String?  @map("report_url")
  createdAt DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@map("scan_results")
}

model Document {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  type      String // ai_policy | risk_assessment | fria | transparency
  version   Int      @default(1)
  content   Json
  pdfUrl    String?  @map("pdf_url")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, type])
  @@map("documents")
}

model Employee {
  id                String   @id @default(cuid())
  companyId         String   @map("company_id")
  userId            String?  @unique @map("user_id")
  name              String
  role              String // job/learning path: employee | manager | it
  trainingCompleted Boolean  @default(false) @map("training_completed")
  certificateUrl    String?  @map("certificate_url")
  createdAt         DateTime @default(now()) @map("created_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  trainingCompletions TrainingCompletion[]
  oversightSystems    AiSystem[] // high-risk systems this employee oversees (Art 26(2))

  @@index([companyId])
  @@map("employees")
}

model TrainingCompletion {
  id          String   @id @default(cuid())
  companyId   String   @map("company_id")
  employeeId  String   @map("employee_id")
  moduleId    String   @map("module_id")
  score       Int // correct answers out of total
  completedAt DateTime @default(now()) @map("completed_at")

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, moduleId])
  @@index([companyId])
  @@map("training_completions")
}

model ComplianceItem {
  id        String           @id @default(cuid())
  companyId String           @map("company_id")
  article   String // e.g. "Art. 4"
  title     String
  status    ComplianceStatus @default(open)
  code      String? // obligation code from lib/compliance/obligations.ts
  required  Boolean          @default(true) // false = advisory ("aanbevolen")
  deadline  DateTime?
  updatedAt DateTime         @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("compliance_items")
}

/// Leads from the public contact form. Not tied to a company/account.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  subject   String?
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("contact_messages")
}

/// Fixed-window rate-limit counters, keyed by "<action>:<ip>". A shared store
/// (vs in-memory) so limits hold across serverless instances. Rows are
/// self-expiring by resetAt; a stale row is simply overwritten on next hit.
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @map("reset_at")

  @@index([resetAt])
  @@map("rate_limits")
}

/// The "keep you current" changelog, editable from the super-admin console.
/// Dates are stored as "YYYY-MM-DD" strings to match the app's date handling
/// exactly (daysSince/formatDate) — no conversion in the mapper. `affects*` are
/// the relevance flags matched against a company's CompanySignals; `addedAt` is
/// the publish date that drives the email cron. Only `status = "published"` rows
/// are shown to customers / on the public page.
model RegulatoryUpdate {
  id                String   @id @default(cuid())
  date              String // "YYYY-MM-DD" — regulatory decision/publication date
  title             String
  summary           String
  detail            String[] @default([])
  category          String // deadline|prohibition|transparency|gpai|literacy|enforcement
  sourceLabel       String   @map("source_label")
  sourceUrl         String   @map("source_url")
  affectsEveryone   Boolean  @default(false) @map("affects_everyone")
  affectsHighRisk   Boolean  @default(false) @map("affects_high_risk")
  affectsProhibited Boolean  @default(false) @map("affects_prohibited")
  affectsLimited    Boolean  @default(false) @map("affects_limited")
  affectsProvider   Boolean  @default(false) @map("affects_provider")
  productImpact     String?  @map("product_impact")
  recert            String?
  addedAt           String?  @map("added_at") // "YYYY-MM-DD" publish date (drives the cron)
  status            String   @default("draft") // draft | published
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@map("regulatory_updates")
}
